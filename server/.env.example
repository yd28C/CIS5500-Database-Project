# Copy to .env and fill in. .env is gitignored — never commit real credentials.
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=postgres
# Set to false only for a local Postgres without SSL
DB_SSL=true
# Optional path to the trusted AWS RDS CA bundle for certificate verification.
# DB_SSL_CA_FILE=/path/to/rds-global-ca.pem
PORT=8080
